# Copy to .env.local and fill in. Never commit real values.
# Production and Preview values live in Vercel → Settings → Environment Variables.
# Preview (dev branch) must use its own Neon branch and VAPID keys, never production's.

# Neon Postgres connection string (pooled). Production DB is eu-central-1 (Frankfurt).
DATABASE_URL=

# NextAuth v5 JWT secret: `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Bearer secret the Vercel cron sends to /api/cron/*.
CRON_SECRET=

# Web push (VAPID): `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push services.
VAPID_SUBJECT=

# Vercel Blob read/write token (profile photos, stories, custom sounds).
BLOB_READ_WRITE_TOKEN=
